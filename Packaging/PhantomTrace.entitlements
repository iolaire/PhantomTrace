<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal entitlements for the hardened runtime (Requirement 16.7).
  - No com.apple.security.app-sandbox: the sandbox would block lsof, signals and unmounting.
  - com.apple.security.automation.apple-events: required because the Egress Shells stage
    runs a fixed osascript to ask Terminal or iTerm to run "cd ~". Without it the hardened
    runtime blocks Apple events. macOS still asks the user for Automation permission.
  Nothing else (no JIT, no unsigned memory, no library-validation bypass, no network).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
