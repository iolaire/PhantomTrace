				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export LC_ALL=C
for f in "$@"; do
  enc=""
  for ((i = 0; i &lt; ${#f}; i++)); do
    c="${f:i:1}"
    case "$c" in
      [a-zA-Z0-9._~-]) enc+="$c" ;;
      *) enc+=$(printf '%%%02X' $(( $(printf '%d' "'$c") &amp; 255 ))) ;;
    esac
  done
  /usr/bin/open "phantomtrace://inspect?path=$enc"
done
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
				</dict>
